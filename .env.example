# ===== 失物招领系统 后端配置样例（复制为 .env 并修改） =====
# 注意：本文件不含真实密钥（全部占位符），提交到仓库；.env 含真实值，勿提交。
# 凭据纪律（安检 L1，2026-09-23）：密钥类值只从环境变量/.env 来，源码零字面量。
# 卡#6（2026-09-23）：本文件与 app/core/config.py 的 Settings 逐项对照核对——
# 每一行都能在 config.py 找到同名字段；config 中未列出的字段（如 OTHER_CATEGORY_NAME）
# 属业务内部常量，不建议通过 .env 调整（Settings 允许 extra，配了也不生效的不要写在这里）。

# ---- 基础 ----
APP_NAME=Campus Lost & Found API
API_V1_PREFIX=/api/v1
# 调试开关：只管调试行为（日志冗余等）。⚠️ 不再牵动限流/验证码显隐（安检 L1-3 已拆分）
DEBUG=true

# ---- 安全开关（安检 L1-3：一个开关只管一件事） ----
# send-sms 响应附带 dev_code（验证码直接显示，供"家人自助注册"演示）；公网部署必须 false
SHOW_SMS_CODE=false
# API 限流总开关（默认 true 生效）；仅测试套件需要显式关闭
RATE_LIMIT_ENABLED=true
# 是否播种演示账号/示例物品（scripts/seed.py 的 demo_loser 等）；默认 false 不播种
SEED_DEMO=false

# ---- 数据库（dev 默认 SQLite；生产切 MySQL 8.0/9.5） ----
# 本地开发可保留 SQLite；生产 / 本机 MySQL 9.5 使用下面这行（口令占位，自行替换）：
DATABASE_URL=mysql+pymysql://lf:change-me-db-password@127.0.0.1:3306/lostfound
# DATABASE_URL=sqlite:///./dev.db
DB_ECHO=false

# ---- 可观测层（v17⑤：request_id 全链路 + JSON 日志 + /metrics + 慢 SQL，零外部依赖） ----
# true=单行 JSON 结构化日志（采集器友好）；false=人类可读格式；两者均携带 request_id
LOG_JSON=true
# 慢 SQL 告警阈值（毫秒），超过打 WARNING（日志含耗时与语句摘要 + request_id）
SLOW_SQL_MS=100
# 演示端点 /__demo/slow（人为慢接口 + 慢 SQL，展示 request_id 定位）；生产必须 false
OBS_DEMO_ENDPOINT=false

# ---- Redis（启用配置；无服务时自动内存兜底） ----
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT ----
# 必填：随机 64 位 hex（生成：python -c "import secrets;print(secrets.token_hex(32))"）。
# 留空 / dev- 开头 / 占位符值（含本行示例值）→ 应用启动直接拒绝（fail fast）
JWT_SECRET=change-me-to-a-random-64hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 管理员 ----
# 注册邀请码：留空 = 管理员邀请通道禁用（启动时日志说明）；启用必须配置强口令，勿用示例值
ADMIN_APPLY_CODE=
# 管理员留存窗（天）：物品过期后保留多久才进入物理清理范围
ADMIN_RETENTION_DAYS=270

# ---- 视觉识别（进程内 VisionService） ----
YOLO_DEVICE=cpu
YOLO_MODEL_DIR=models/weights
YOLO_FALLBACK_CATEGORY_ID=0
# 用户训练 11 类校园失物模型（config 默认 best.pt，已替代通用 COCO 权重）
YOLO_COCO_MODEL=best.pt
YOLO_WORLD_MODEL=yolov8s-world.pt
# 检测置信度阈值（config 默认 0.12：压低门槛换弱类召回，勿随意调高）
YOLO_CONF_THRESHOLD=0.12

# ---- 交接码（双码交叉验证模型） ----
HANDOVER_TTL_SEC=10

# ---- 短信 ----
# ⚠️ 以下三项（SMS_RATE_LIMIT_PER_MIN / IMG_STORAGE / AUDIT_RETENTION_DAYS）当前代码未消费
#（审查 P1 盘点，2026-09-24），保留仅为向后兼容；配置变更不影响行为。
SMS_RATE_LIMIT_PER_MIN=5
SMS_RESEND_INTERVAL_SEC=60

# ---- API 限流（v13：固定窗口） ----
RATE_LIMIT_AUTH_PER_MIN=10
# 认证严格档（登录/注册/发短信逐端点，按 IP；审查 P1 补录，此前示例缺失）
RATE_LIMIT_AUTH_STRICT_PER_MIN=5
RATE_LIMIT_PUBLISH_PER_MIN=10
RATE_LIMIT_PREVIEW_PER_MIN=30

# ---- 请求体护栏（安检 L1） ----
# Content-Length 超限直接 413；默认与上传上限联动（IMG_MAX_COUNT×IMG_MAX_SIZE_MB+开销）
REQUEST_BODY_MAX_MB=100

# ---- 匹配打分（v10 评分引擎 v2：七子维度权重合计 100 + Q10 归一化） ----
# 疑似匹配阈值（判定对象为归一化后的 total）。
# v16（2026-09-24）：80→78——γ 中性分对称化后分数系统性下移约 4 分，阈值随新分布重标定
#（主集 F1 78.0%，见 evaluation/results-v16.md）。改权重/阈值后必跑 run_eval.py。
MATCH_THRESHOLD=78
# 低分「视觉」阈值：仅供前端弱化展示，与 MATCH_THRESHOLD 完全解耦
MATCH_LOW_SCORE=60
# 普通候选保底条数（≥阈值的疑似候选另受 MATCH_SUSPECT_MAX 护栏约束）
MATCH_TOP_N=50
MATCH_SUSPECT_MAX=60
# 归一化开关（kill switch）：false 时 k≡1.0 退回纯 raw 分
MATCH_NORMALIZE=true
# 归一化防爆下限：k = 100 / max(失主已填权重和, 本值)
MATCH_NORM_MIN_WEIGHT=50
# γ 中性分（v16）：失主已提供但候选未提及的文本五维按 γ×满分 计入（"没提到"≠"不符"）；
# 0 = 关闭回滚；photo_category 与 time 维不参与
MATCH_NEUTRAL_GAMMA=0.5
# v2 时间衰减 τ（天）：time = 10·exp(-Δdays/τ)
MATCH_TIME_TAU_DAYS=15
MATCH_W2_PHOTO_CAT=20
MATCH_W2_QTY=15
MATCH_W2_COLOR=20
MATCH_W2_STATE=10
MATCH_W2_PLACE=15
MATCH_W2_KEYWORD=10
MATCH_W2_TIME=10

# ---- 图片 / 存储 ----
IMG_MAX_COUNT=9
IMG_MAX_SIZE_MB=10
IMG_STORAGE=local
# 本地上传根目录；默认项目内 uploads 绝对路径，一般无需设置
# UPLOAD_DIR=uploads

# ---- 保留期 ----
IM_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# ---- 实时通信（前端轮询） ----
IM_POLL_INTERVAL_MS=4000

# ---- 分页 ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
