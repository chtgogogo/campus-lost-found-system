# ===== 失物招领系统 后端配置样例（复制为 .env 并修改） =====
# 注意：本文件不含真实密钥，提交到仓库；.env 含真实值，勿提交。

# ---- 基础 ----
APP_NAME=Campus Lost & Found API
API_V1_PREFIX=/api/v1
DEBUG=true

# ---- 数据库（dev 默认 SQLite；生产切 MySQL 8.0/9.5） ----
# 本地开发可保留 SQLite；生产 / 本机 MySQL 9.5 使用下面这行：
DATABASE_URL=mysql+pymysql://lf:lf@127.0.0.1:3306/lostfound
# DATABASE_URL=sqlite:///./dev.db
DB_ECHO=false

# ---- Redis（启用配置；无服务时自动内存兜底） ----
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT ----
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 视觉识别（进程内 VisionService，真 YOLOv8n-COCO + YOLO-World） ----
YOLO_DEVICE=cpu
YOLO_MODEL_DIR=models/weights
YOLO_FALLBACK_CATEGORY_ID=0
YOLO_COCO_MODEL=yolov8n.pt
YOLO_WORLD_MODEL=yolov8s-world.pt
YOLO_CONF_THRESHOLD=0.25

# ---- 交接码 ----
HANDOVER_TTL_MIN=30

# ---- 短信 ----
SMS_RATE_LIMIT_PER_MIN=5
SMS_RESEND_INTERVAL_SEC=60

# ---- 匹配打分（§5.4） ----
MATCH_W1=40
MATCH_W2=25
MATCH_W3=20
MATCH_W4=15
MATCH_THRESHOLD=80
TIME_DECAY_TAU_DAYS=3

# ---- 区域 ----
DEFAULT_REGION_CODE=510107

# ---- 图片 / 存储 ----
IMG_MAX_COUNT=9
IMG_MAX_SIZE_MB=10
IMG_STORAGE=local

# ---- 保留期 ----
IM_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365

# ---- 分页 ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
