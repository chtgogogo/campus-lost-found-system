# ===== 失物招领系统 后端配置样例（复制为 .env 并修改） =====
# 注意：本文件不含真实密钥（全部占位符），提交到仓库；.env 含真实值，勿提交。
# 凭据纪律（安检 L1，2026-09-23）：密钥类值只从环境变量/.env 来，源码零字面量。

# ---- 基础 ----
APP_NAME=Campus Lost & Found API
API_V1_PREFIX=/api/v1
# 调试开关：只管调试行为（日志冗余等）。⚠️ 不再牵动限流/验证码显隐（安检 L1-3 已拆分）
DEBUG=true

# ---- 安全开关（安检 L1-3：一个开关只管一件事） ----
# send-sms 响应附带 dev_code（验证码直接显示，供"家人自助注册"演示）；公网部署必须 false
SHOW_SMS_CODE=false
# API 限流总开关（默认 true 生效）；仅测试套件需要显式关闭
RATE_LIMIT_ENABLED=true
# 是否播种演示账号/示例物品（scripts/seed.py 的 demo_loser 等）；默认 false 不播种
SEED_DEMO=false

# ---- 数据库（dev 默认 SQLite；生产切 MySQL 8.0/9.5） ----
# 本地开发可保留 SQLite；生产 / 本机 MySQL 9.5 使用下面这行（口令占位，自行替换）：
DATABASE_URL=mysql+pymysql://lf:change-me-db-password@127.0.0.1:3306/lostfound
# DATABASE_URL=sqlite:///./dev.db
DB_ECHO=false

# ---- Redis（启用配置；无服务时自动内存兜底） ----
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT ----
# 必填：随机 64 位 hex（生成：python -c "import secrets;print(secrets.token_hex(32))"）。
# 留空 / dev- 开头 / 占位符值 → 应用启动直接拒绝（fail fast）
JWT_SECRET=change-me-to-a-random-64hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 管理员邀请码 ----
# 注册时命中则静默升为管理员。留空 = 管理员邀请通道禁用（启动时日志说明）。
ADMIN_APPLY_CODE=change-me-to-a-strong-admin-code

# ---- 视觉识别（进程内 VisionService，真 YOLOv8n-COCO + YOLO-World） ----
YOLO_DEVICE=cpu
YOLO_MODEL_DIR=models/weights
YOLO_FALLBACK_CATEGORY_ID=0
YOLO_COCO_MODEL=yolov8n.pt
YOLO_WORLD_MODEL=yolov8s-world.pt
YOLO_CONF_THRESHOLD=0.25

# ---- 交接码 ----
HANDOVER_TTL_MIN=30

# ---- 短信 ----
SMS_RATE_LIMIT_PER_MIN=5
SMS_RESEND_INTERVAL_SEC=60

# ---- 匹配打分（§5.4） ----
MATCH_W1=40
MATCH_W2=25
MATCH_W3=20
MATCH_W4=15
MATCH_THRESHOLD=80
TIME_DECAY_TAU_DAYS=3

# ---- 区域 ----
DEFAULT_REGION_CODE=510107

# ---- 图片 / 存储 ----
IMG_MAX_COUNT=9
IMG_MAX_SIZE_MB=10
IMG_STORAGE=local

# ---- 请求体护栏 ----
# Content-Length 超限直接 413；默认与上传上限联动（IMG_MAX_COUNT×IMG_MAX_SIZE_MB+开销）
REQUEST_BODY_MAX_MB=100

# ---- 保留期 ----
IM_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365

# ---- 分页 ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
